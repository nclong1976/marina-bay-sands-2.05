# Sands Club — required environment variables
#
# The app's real backend is Supabase (not Base44). Only the two VITE_SUPABASE_*
# variables below are required for the app to function. They are read at BUILD
# time (Vite inlines them), so on a host like Railway make sure they are set
# as project Variables BEFORE the build runs.

# Supabase project URL and anon/publishable key (Project Settings -> API in Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App display name (optional)
VITE_APP_NAME=Sands Club

# --- Not required for normal operation ---
# Only needed if you re-enable the legacy Base44 SDK integration.
# VITE_BASE44_APP_ID=
# VITE_BASE44_APP_BASE_URL=

# Only needed if the Socket.io server runs on a DIFFERENT host/domain than the
# frontend. Not needed on Railway/Render/Fly.io single-service deploys, since
# server/index.js serves both the built frontend and Socket.io from one origin.
# VITE_SOCKET_SERVER_URL=
